<div class="page-container">

  <!-- System Architecture & Stateless Session Status Card -->
  <section class="card status-card">
    <div class="card-header">
      <div class="card-title-group">
        <span class="status-indicator live"></span>
        <h2>Trạng Thái Hạ Tầng Cloud &amp; Stateless Session</h2>
      </div>
      <span class="badge badge-outline">Auto-Scaling Ready</span>
    </div>
    <div class="status-grid">
      <div class="status-box">
        <span class="status-title">☁️ Cơ sở dữ liệu Cloud</span>
        <div class="status-details">
          <p><strong>DB:</strong> <code>DB_{{studentId}}</code> (MongoDB Atlas)</p>
          <p><strong>Read Account:</strong> <span class="tag-read">{{studentId}}_read</span> (Chỉ đọc)</p>
          <p><strong>Write Account:</strong> <span class="tag-write">{{studentId}}_write</span> (Chỉ ghi)</p>
        </div>
      </div>

      <div class="status-box">
        <span class="status-title">⚡ Stateless Session (Tập trung trên Atlas)</span>
        <div class="status-details">
          <p><strong>Lưu trữ:</strong> Bộ nhớ Cloud (Collection: <code>sessions</code>)</p>
          <p><strong>RAM Máy chủ:</strong> <span class="tag-stateless">Không lưu RAM (Stateless 100%)</span></p>
          <p><strong>Lượt truy cập phiên:</strong> <span class="badge-count">{{sessionViews}} lần</span></p>
        </div>
      </div>

      <div class="status-box">
        <span class="status-title">⚙️ Thuật Toán Cá Nhân Hóa</span>
        <div class="status-details">
          <p><strong>Tiền tố mã sách:</strong> Bắt buộc là <strong class="text-accent">{{requiredPrefix}}</strong> (3 số cuối MSSV)</p>
          <p><strong>Công thức VAT:</strong> (5 + 6)% = <strong class="text-accent">{{vatRate}}%</strong></p>
          <p><strong>Cơ chế tính giá:</strong> Giá sau thuế = Giá gốc &times; (1 + {{vatRate}}%)</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Notification Alerts -->
  {{#if successMessage}}
    <div class="alert alert-success">
      <div class="alert-icon">✓</div>
      <div class="alert-content">
        <strong>Thành công!</strong>
        <p>{{successMessage}}</p>
      </div>
    </div>
  {{/if}}

  {{#if errorMessage}}
    <div class="alert alert-danger">
      <div class="alert-icon">⚠️</div>
      <div class="alert-content">
        <strong>Cảnh báo từ chối / Lỗi!</strong>
        <p>{{errorMessage}}</p>
      </div>
    </div>
  {{/if}}

  <div class="content-grid">
    <!-- Form Thêm Sách Mới (Luồng Ghi) -->
    <section class="card form-card">
      <div class="card-header">
        <h2>✍️ Thêm Sách Mới (Luồng Ghi)</h2>
        <span class="tag-write">Ghi vào DB qua {{studentId}}_write</span>
      </div>
      <form action="/books" method="POST" class="book-form" id="bookForm">
        <div class="form-group">
          <label for="code">Mã Sách <span class="required">*</span></label>
          <div class="input-with-hint">
            <input 
              type="text" 
              id="code" 
              name="code" 
              placeholder="VD: {{requiredPrefix}}-JS01, {{requiredPrefix}}-CLOUD" 
              required
            >
          </div>
          <small class="hint-text">
            Yêu cầu: Bắt buộc phải có tiền tố là 3 số cuối MSSV (<strong class="text-accent">{{requiredPrefix}}</strong>). Nếu sai hệ thống sẽ từ chối!
          </small>
        </div>

        <div class="form-group">
          <label for="title">Tên Sách <span class="required">*</span></label>
          <input 
            type="text" 
            id="title" 
            name="title" 
            placeholder="VD: Giáo trình Điện Toán Đám Mây" 
            required
          >
        </div>

        <div class="form-group">
          <label for="author">Tác Giả <span class="required">*</span></label>
          <input 
            type="text" 
            id="author" 
            name="author" 
            placeholder="VD: Nguyễn Văn A" 
            required
          >
        </div>

        <div class="form-group">
          <label for="price">Giá Gốc Chưa Thuế (VNĐ) <span class="required">*</span></label>
          <input 
            type="number" 
            id="price" 
            name="price" 
            min="0" 
            step="1000" 
            placeholder="VD: 150000" 
            required
          >
        </div>

        <!-- Realtime Tax Preview Box -->
        <div class="tax-calculation-box" id="taxBox">
          <div class="tax-calc-row">
            <span>Thuế suất VAT áp dụng:</span>
            <strong>{{vatRate}}%</strong>
          </div>
          <div class="tax-calc-row">
            <span>Tiền thuế dự tính:</span>
            <span id="previewVatAmount">0 VNĐ</span>
          </div>
          <div class="tax-calc-row total-row">
            <span>Giá sau thuế (lưu xuống Cloud):</span>
            <strong id="previewTotal">0 VNĐ</strong>
          </div>
        </div>

        <button type="submit" class="btn btn-primary" id="btnSubmit">
          <span>Lưu Sách Lên Cloud MongoDB</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </button>
      </form>
    </section>

    <!-- Bảng Danh Sách Sách (Luồng Đọc) -->
    <section class="card table-card">
      <div class="card-header">
        <div>
          <h2>📖 Danh Sách Sách Hiện Có (Luồng Đọc)</h2>
          <span class="tag-read">Truy vấn từ DB qua {{studentId}}_read</span>
        </div>
        <span class="badge badge-count">{{books.length}} cuốn sách</span>
      </div>

      <div class="table-responsive">
        <table class="data-table">
          <thead>
            <tr>
              <th>Mã Sách</th>
              <th>Tên Sách</th>
              <th>Tác Giả</th>
              <th>Giá Gốc</th>
              <th>VAT</th>
              <th>Giá Sau Thuế</th>
            </tr>
          </thead>
          <tbody>
            {{#if books.length}}
              {{#each books}}
                <tr>
                  <td><span class="code-pill">{{this.code}}</span></td>
                  <td><strong>{{this.title}}</strong></td>
                  <td class="text-muted">{{this.author}}</td>
                  <td>{{this.price}} VNĐ</td>
                  <td><span class="badge badge-success">{{this.vatRate}}%</span></td>
                  <td><strong class="price-highlight">{{this.priceWithVAT}} VNĐ</strong></td>
                </tr>
              {{/each}}
            {{else}}
              <tr>
                <td colspan="6" class="empty-state">
                  <div class="empty-box">
                    <p>Chưa có dữ liệu sách nào trên Cloud Database <code>DB_{{studentId}}</code>.</p>
                    <small>Hãy thêm cuốn sách đầu tiên ở biểu mẫu bên cạnh!</small>
                  </div>
                </td>
              </tr>
            {{/if}}
          </tbody>
        </table>
      </div>
    </section>
  </div>
</div>

<script>
  // Realtime tax calculation in browser
  const priceInput = document.getElementById('price');
  const previewVatAmount = document.getElementById('previewVatAmount');
  const previewTotal = document.getElementById('previewTotal');
  const vatRate = {{vatRate}};

  function updateTaxPreview() {
    const val = parseFloat(priceInput.value) || 0;
    const vatAmount = Math.round(val * (vatRate / 100));
    const total = val + vatAmount;

    previewVatAmount.innerText = vatAmount.toLocaleString('vi-VN') + ' VNĐ';
    previewTotal.innerText = total.toLocaleString('vi-VN') + ' VNĐ';
  }

  if (priceInput) {
    priceInput.addEventListener('input', updateTaxPreview);
  }
</script>
