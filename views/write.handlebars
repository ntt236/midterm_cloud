<div class="page-container">

  <!-- Thông báo từ Session (nếu có) -->
  {{#if errorMessage}}
  <div class="alert alert-danger">
    {{errorMessage}}
  </div>
  {{/if}}

  {{#if successMessage}}
  <div class="alert alert-success">
    {{successMessage}}
  </div>
  {{/if}}

  <!-- Card Thông tin Luồng Ghi -->
  {{!-- <div class="info-card">
    <div class="info-title">✍️ Luồng Ghi Dữ Liệu (Write Flow)</div>
    <div class="info-grid">
      <div class="info-item">
        Tài khoản sử dụng: <code>{{studentId}}_write</code> (Quyền: <strong>Chỉ Ghi / Write-only</strong>)
      </div>
      <div class="info-item">
        Quy tắc mã sách: Tiền tố bắt buộc là <strong>{{requiredPrefix}}</strong> (3 số cuối MSSV)
      </div>
      <div class="info-item">
        Thuế suất VAT động: <strong>{{vatRate}}%</strong> (Công thức: Chữ số cuối + 6)%
      </div>
    </div>
  </div> --}}

  <!-- Form Thêm Sách Mới -->
  <section class="card form-container-simple">
    <div class="card-header">
      <h2>Biểu Mẫu Thêm Sách Mới</h2>
      <p class="card-subtitle">Dữ liệu sẽ được lưu trực tiếp vào MongoDB Atlas qua tài khoản Ghi.</p>
    </div>

    <form action="/write" method="POST" class="book-form">
      <div class="form-group">
        <label for="code">Mã Sách *</label>
        <input type="text" id="code" name="code" placeholder="Ví dụ: {{requiredPrefix}}-01, {{requiredPrefix}}-NODEJS"
          required>
        <small class="hint-text">
          Bắt buộc bắt đầu bằng <strong>{{requiredPrefix}}</strong>. Nếu sai hệ thống sẽ từ chối xử lý!
        </small>
      </div>

      <div class="form-group">
        <label for="title">Tên Sách *</label>
        <input type="text" id="title" name="title" placeholder="Ví dụ: Lập trình Cloud Computing" required>
      </div>

      <div class="form-group">
        <label for="author">Tác Giả *</label>
        <input type="text" id="author" name="author" placeholder="Ví dụ: {{studentName}}" required>
      </div>

      <div class="form-group">
        <label for="price">Giá Gốc Chưa Thuế (VNĐ) *</label>
        <input type="number" id="price" name="price" min="0" step="1000" placeholder="Ví dụ: 100000" required>
      </div>

      <!-- Khung Tính Thuế Tự Động -->
      <div class="tax-preview">
        <div class="tax-row">
          <span>Mức VAT áp dụng:</span>
          <strong>{{vatRate}}%</strong>
        </div>
        <div class="tax-row">
          <span>Tiền thuế ước tính:</span>
          <span id="previewVatAmount">0 VNĐ</span>
        </div>
        <div class="tax-row total">
          <span>Giá sau thuế (lưu xuống Cloud):</span>
          <strong id="previewTotal">0 VNĐ</strong>
        </div>
      </div>

      <div class="form-actions">
        <button type="submit" class="btn">Lưu Sách Lên Cloud MongoDB</button>
        <a href="/" class="btn btn-secondary">Quay Lại Trang Xem Danh Sách</a>
      </div>
    </form>
  </section>

</div>

<script>
  // Tính thuế realtime trong trình duyệt
  const priceInput = document.getElementById('price');
  const previewVatAmount = document.getElementById('previewVatAmount');
  const previewTotal = document.getElementById('previewTotal');
  const vatRate = {{ vatRate }};

  function updateTax() {
    const val = parseFloat(priceInput.value) || 0;
    const vat = Math.round(val * (vatRate / 100));
    const total = val + vat;

    previewVatAmount.innerText = vat.toLocaleString('vi-VN') + ' VNĐ';
    previewTotal.innerText = total.toLocaleString('vi-VN') + ' VNĐ';
  }

  if (priceInput) {
    priceInput.addEventListener('input', updateTax);
  }
</script>