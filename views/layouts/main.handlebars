<!DOCTYPE html>
<html lang="vi">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Quản Lý Sách Cloud - {{studentId}}</title>
  <link rel="stylesheet" href="/css/style.css">
</head>

<body>
  <!-- Header Đơn Giản -->
  {{!-- <header class="app-header">
    <div class="header-container">
      <div>
        <h1 class="brand-title">Quản Lý Sách Cloud</h1>
        <p class="brand-subtitle">Hệ thống phân quyền Least Privilege &bull; Stateless Session trên MongoDB Atlas</p>
      </div>
      <div class="header-badges">
        <span class="badge">DB_{{studentId}}</span>
        <span class="badge">VAT: {{vatRate}}%</span>
        <span class="badge">Session: {{sessionViews}} views</span>
      </div>
    </div>
  </header> --}}

  <!-- Navigation Bar: Tách bạch 2 trang Read và Write -->
  <nav class="app-nav">
    <div class="nav-container">
      <a href="/" class="nav-tab {{#if isReadTab}}active{{/if}}">
        📖 Xem Danh Sách Sách (Tài khoản Read: {{studentId}}_read)
      </a>
      <a href="/write" class="nav-tab {{#if isWriteTab}}active{{/if}}">
        ✍️ Thêm Sách Mới (Tài khoản Write: {{studentId}}_write)
      </a>
    </div>
  </nav>

  <!-- Nội Dung Trang -->
  <main class="main-content">
    {{{body}}}
  </main>

  <!-- Footer Đơn Giản (Bắt buộc theo yêu cầu đề bài) -->
  <footer class="app-footer">
    <div class="footer-container">
      <div class="footer-info">
        <span>Sinh viên: <strong>{{studentName}}</strong></span>
        <span>MSSV: <strong>{{studentId}}</strong></span>
        <span>Mức VAT: <strong>{{vatRate}}% (Chữ số cuối {{studentId}} + 6)</strong></span>
      </div>
      <div class="footer-copy">
        <span>Điện toán đám mây &bull; MongoDB Atlas</span>
      </div>
    </div>
  </footer>
</body>

</html>